parameters:
  level: 6
  paths:
    - wp-thumbhash.php
    - src/
  scanDirectories:
    - vendor/.wordpress
    - vendor/php-stubs
    - vendor-prefixed
  ignoreErrors:
    - '#Constant FS_CHMOD_FILE not found#'
    # defined by WordPress inside wp_initial_constants()
    - '#Constant MINUTE_IN_SECONDS not found#'