{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Only dependencies that ship in the release zip. Dev tooling is updated by hand.",
  "extends": ["config:recommended"],
  "enabledManagers": ["composer"],
  "schedule": ["before 6am on monday"],
  "timezone": "Europe/Berlin",
  "ignorePaths": ["vendor-prefixed/**"],
  "gitIgnoredAuthors": ["bot@rassohilber.com"],
  "packageRules": [
    {
      "description": "Disable everything except the prefixed dependencies",
      "matchPackageNames": [
        "!srwiez/thumbhash",
        "!yahnis-elsts/plugin-update-checker"
      ],
      "enabled": false
    },
    {
      "description": "The Renovate Sync workflow runs `composer prefix` on the branch",
      "matchPackageNames": [
        "srwiez/thumbhash",
        "yahnis-elsts/plugin-update-checker"
      ],
      "groupName": "prefixed dependencies"
    }
  ]
}
