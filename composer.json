{
  "name": "hirasso/wp-thumbhash",
  "description": "A WordPress plugin to generate and render thumbhash placeholders for your lazy-loaded images 🦦",
  "license": "GPL-3.0-or-later",
  "type": "wordpress-plugin",
  "authors": [
    {
      "name": "Rasso Hilber",
      "email": "mail@rassohilber.com"
    }
  ],
  "require": {
    "php": ">=8.2",
    "composer/installers": "^2.3"
  },
  "require-dev": {
    "laravel/pint": "^1.19",
    "pestphp/pest": "^3.8",
    "php-stubs/wp-cli-stubs": "^2.12",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.1",
    "roots/wordpress": "*",
    "srwiez/thumbhash": "^1.6",
    "symfony/var-dumper": "^7.2",
    "wp-cli/i18n-command": "^2.7",
    "wp-cli/wp-cli": "^2.12",
    "yahnis-elsts/plugin-update-checker": "^5.5",
    "yoast/phpunit-polyfills": "^4.0"
  },
  "minimum-stability": "dev",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "Hirasso\\WPThumbhash\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Hirasso\\WPThumbhash\\Tests\\": "tests/"
    },
    "exclude-from-classmap": [
      "tests/E2E/e2e-plugin/"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "composer/installers": true,
      "pestphp/pest-plugin": true,
      "phpstan/extension-installer": true,
      "roots/wordpress-core-installer": true
    },
    "platform": {
      "php": "8.2"
    }
  },
  "scripts": {
    "prefix": [
      "sh -c 'test -f ./tools/strauss.phar || curl -sfL https://github.com/BrianHenryIE/strauss/releases/download/0.30.0/strauss.phar -o tools/strauss.phar'",
      "@php tools/strauss.phar"
    ],
    "post-install-cmd": "tools/sync-wp-env-core.sh",
    "post-update-cmd": [
      "@prefix",
      "tools/sync-wp-env-core.sh"
    ],
    "test": "pest --no-coverage"
  },
  "scripts-descriptions": {},
  "post-install-cmd": "composer normalize",
  "extra": {
    "wordpress-install-dir": "vendor/.wordpress",
    "strauss": {
      "target_directory": "vendor-prefixed",
      "namespace_prefix": "Hirasso\\WPThumbhash\\Vendor\\",
      "classmap_prefix": "WPThumbhash_Vendor_",
      "constant_prefix": "WP_THUMBHASH_VENDOR_",
      "function_prefix": false,
      "packages": [
        "srwiez/thumbhash",
        "yahnis-elsts/plugin-update-checker"
      ],
      "exclude_from_prefix": {
        "packages": [
          "yahnis-elsts/plugin-update-checker"
        ]
      },
      "delete_vendor_packages": false,
      "delete_vendor_files": false,
      "include_modified_date": false,
      "include_author": false
    }
  }
}
