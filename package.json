{
  "name": "wp-thumbhash",
  "type": "module",
  "private": true,
  "version": "0.2.0",
  "scripts": {
    "prepare": "husky",
    "preinstall": "npx only-allow pnpm",
    "format:assets": "npx prettier --write '**/*.{ts,js,css,scss}'",
    "format:php": "./vendor/bin/pint src tools",
    "validate:php": "tools/cli/cli.js validate:php",
    "version": "pnpm run validate:php && pnpm changeset version && tools/cli/cli.js version:patch",
    "pot:make": "SLUG=$(basename \"$(pwd)\"); wp i18n make-pot . languages/$SLUG.pot --include=src,$SLUG.php",
    "env": "wp-env",
    "wp": "wp-env run cli wp --env-cwd=wp-content/plugins/wp-thumbhash",
    "env:test": "wp-env --config .wp-env.test.json",
    "env:cli": "wp-env run cli --env-cwd=wp-content/plugins/wp-thumbhash",
    "launch": "open $(wp-env status --json | jq -r .urls.development)",
    "launch:test": "open $(wp-env --config .wp-env.test.json status --json | jq -r .urls.development)",
    "test": "pnpm test:pest && pnpm env:test reset && pnpm env:test start && pnpm test:e2e",
    "test:pest": "wp-env --config .wp-env.test.json run cli --env-cwd=wp-content/plugins/wp-thumbhash vendor/bin/pest --no-coverage",
    "test:e2e": "pnpm exec playwright test --config ./tests/E2E/playwright.config.ts",
    "test:e2e:dev": "PLAYWRIGHT_ENV=dev pnpm test:e2e --ui",
    "test:e2e:install": "pnpm exec playwright install --with-deps",
    "act:php-tests": "act -j php-tests --matrix php:8.2 --container-options '--privileged'",
    "analyse": "vendor/bin/phpstan analyse --memory-limit=2G"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@hirasso/thumbhash-custom-element": "^0.5.8",
    "@playwright/test": "^1.59.1",
    "@types/node": "^22.19.17",
    "@wordpress/env": "^11.16.0",
    "fast-glob": "^3.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "picocolors": "^1.1.1",
    "prettier": "^3.8.3"
  }
}
